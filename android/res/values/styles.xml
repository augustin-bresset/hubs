<?xml version="1.0" encoding="utf-8"?>
<!-- Mêmes couleurs que le thème sombre des pages (public/style.css). -->
<resources>
    <color name="bg">#151614</color>
    <color name="card">#1f211e</color>
    <color name="text">#ecebe6</color>
    <color name="muted">#9c9a92</color>
    <color name="accent">#5fc2a8</color>
    <color name="accent_text">#0d1f1a</color>
    <color name="warn">#e39a5c</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
    </style>
</resources>
